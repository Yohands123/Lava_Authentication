{
  "name": "lavaauth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev --port 8787",
    "dev:client": "vite build --watch",
    "lamp": "vite --open /sandbox.html",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:enforce": "playwright test --config playwright.enforce.config.ts",
    "test:hardening": "playwright test --config playwright.hardening.config.ts",
    "test:load": "node scripts/load-local.mjs",
    "ml:phase4": "node scripts/extract-phase4.mjs && .venv/Scripts/python ml/phase4.py && .venv/Scripts/python ml/train_application.py && node scripts/benchmark-inference.mjs",
    "ml:phase5": "node scripts/python-local.mjs ml/phase5.py",
    "ml:phase5:capture": "node scripts/phase5-capture.mjs",
    "ml:phase5:features": "node scripts/phase5-experiments.mjs",
    "ml:phase5:benchmark": "node scripts/benchmark-phase5.mjs",
    "ml:phase5:withdraw": "node scripts/python-local.mjs ml/study_withdraw.py",
    "test:research": "node scripts/check-study-import.mjs",
    "test:ml": "node scripts/python-local.mjs -m unittest discover -s ml -p \"test_*.py\" -v",
    "test:automation": "node scripts/verify-automation.mjs",
    "test:environment": "node scripts/environment-probe.mjs",
    "preview": "node scripts/preview.mjs",
    "test:adversarial": "node scripts/adversarial.mjs",
    "ml:ingest": "python ml/ingest.py --download-delbot",
    "ml:features": "node scripts/extract-features.mjs",
    "ml:train": ".venv/Scripts/python ml/train.py",
    "ml:validate": "node scripts/research-benchmarks.mjs && .venv/Scripts/python ml/validate.py",
    "ml:import-consenting": "node scripts/import-consenting.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.phase6.json",
    "lint": "eslint src tests scripts *.ts *.mjs --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:console && npm run test:phase6:storage",
    "deploy": "vite build && wrangler deploy --env production",
    "test:live": "node scripts/test-console.mjs",
    "test:console": "node --test scripts/test-console/console.test.mjs",
    "phase6:adversarial": "node scripts/phase6/adversarial.mjs",
    "phase6:features": "node scripts/phase6/features.mjs",
    "phase6:ml": "node scripts/python-local.mjs ml/phase6.py",
    "phase6:benchmark": "node scripts/phase6/benchmark.mjs",
    "phase6:load": "node scripts/phase6/load.mjs",
    "phase6:sharding": "node scripts/phase6/sharding.mjs",
    "test:phase6": "playwright test --config playwright.phase6.config.ts",
    "test:phase6:storage": "node --test scripts/phase6/storage.test.mjs",
    "phase6:registry": "node scripts/phase6/registry.mjs",
    "phase6:view": "node scripts/phase6/view.mjs",
    "phase6:verify": "node scripts/phase6/verify.mjs"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/unbounded": "^5.1.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "ghost-cursor": "^1.4.2",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
